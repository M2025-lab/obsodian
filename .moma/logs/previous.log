  `material_code` varchar(50) NOT NULL DEFAULT '' COMMENT '品类编码',
  `task_type` int(11) NOT NULL DEFAULT '0' COMMENT '任务类型：0-未指定，3-通知复尺',
  `gb_code` varchar(16) NOT NULL DEFAULT '' COMMENT '城市国标编码（冗余自 task_dispatch.gb_code，供指标查询城市维度）；空串-无城市编码',
  `task_dispatch_id` bigint(20) NOT NULL DEFAULT '0' COMMENT '任务id',
  `task_dispatch_node_id` bigint(20) NOT NULL DEFAULT '0' COMMENT '节点id：提交=通知节点(nodeType=20)；驳回=本次qualified=2提交的节点',
  `record_type` tinyint(4) NOT NULL DEFAULT '0' COMMENT '记录类型：1-通知提交，2-驳回',
  `notify_execute_type` tinyint(4) NOT NULL DEFAULT '0' COMMENT '执行方式：1-一键通知，2-自动通知，3-手动通知；驳回记录=上一轮提交的执行方式，0-未查到上一轮提交记录',
  `recognized` tinyint(4) NOT NULL DEFAULT '0' COMMENT '是否经过系统识别：0-无识别记录，1-有识别记录',
  `judge_result` tinyint(4) NOT NULL DEFAULT '0' COMMENT '事件时刻识别判定快照：1-可通知，2-不可通知，3-无法判断，4-现场已完成需关闭；0-无识别记录或未判定',
  `recognize_applied` tinyint(4) NOT NULL DEFAULT '0' COMMENT '识别结果是否被应用：1-应用(judge_result=1)，0-未应用(judge_result=2/3/4或无识别记录)',
  `ai_adoption_type` tinyint(4) NOT NULL DEFAULT '0' COMMENT 'AI建议采纳快照：0-未处理（含识别表无推荐值），1-采纳，2-未采纳，3-图片采纳，4-上门时间采纳',
  `operator_id` varchar(64) NOT NULL DEFAULT '' COMMENT '操作人id；空串-无',
  `operator_name` varchar(128) NOT NULL DEFAULT '' COMMENT '操作人姓名；空串-无',
  `event_time` datetime NOT NULL DEFAULT '1900-01-01 00:00:00' COMMENT '事件时间（节点提交时间）',
  `gmt_create` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `gmt_modified` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
