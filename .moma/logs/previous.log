                .filter(v -> v != null && !v.trim().isEmpty())
                .distinct()
                .collect(Collectors.toList());
        Set<String> dispatchedOrderNos = new HashSet<>();
        if (!candidateOrderNos.isEmpty()) {
            for (SupplierProgressByPlanVO row : supplierProgressManager.queryByPlan(SupplierProgressByPlanQueryParam.builder()
                    .orderNos(candidateOrderNos)
                    .build())) {
                for (SupplierProgressByPlanItemVO plan : plansOf(row)) {
                    if (plan.getTaskType() != null && plan.getTaskType() == 5) {
                        dispatchedOrderNos.add(row.getOrderNo().trim());
                        break;
                    }
                }
            }
