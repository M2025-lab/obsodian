  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT COMMENT '主键',
  `project_order_id` bigint(20) unsigned NOT NULL DEFAULT '0' COMMENT '项目订单id',
  `material_code` varchar(50) NOT NULL DEFAULT '' COMMENT '品类编码',
  `task_type` int(11) unsigned NOT NULL DEFAULT '0' COMMENT '任务类型：3-复尺，6-安装等',
  `judge_result` tinyint(4) NOT NULL DEFAULT '0' COMMENT '最新系统判定结果：0-未判定，1-任务可通知，2-任务不可通知，3-无法识别是否可通知，4-现场已完成任务需关闭',
  `judge_remark` varchar(1024) NOT NULL DEFAULT '' COMMENT '判断备注',
  `images` varchar(8192) NOT NULL DEFAULT '' COMMENT '通知任务图片，逗号分隔',
  `receive_time` date NOT NULL DEFAULT '1900-01-01' COMMENT '任务接收时间',
  `recognize_time` date NOT NULL DEFAULT '1900-01-01' COMMENT '上游识别结果日期，T的时间基准',
  `recommend_visit_time` date NOT NULL DEFAULT '1900-01-01' COMMENT '最新判定期望上门时间，T+3',
  `notify_execute_type` tinyint(4) NOT NULL DEFAULT '0' COMMENT '通知执行方式：0-未执行，1-一键通知，2-自动通知',
  `ai_adoption_type` tinyint(4) NOT NULL DEFAULT '0' COMMENT 'AI建议采纳情况：0-未处理，1-采纳，2-未采纳，3-图片采纳，4-上门时间采纳',
  `gmt_create` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `gmt_modified` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
  PRIMARY KEY (`id`),
  KEY `idx_project_order_material` (`project_order_id`,`material_code`)
) ENGINE=InnoDB AUTO_INCREMENT=136 DEFAULT CHARSET=utf8mb4 COMMENT='材料现场识别结果'
以及上线加上apollo配置可通知品类
