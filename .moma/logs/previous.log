@PostMapping(value = "api/construction/follow-up/task/search")
    @ApiOperation(value = "跟单任务 ES 条件查询（返回完整 DTO，ES 只出 id，与 page 同结构可平替）", notes = "分公司取服务端配置 follow.up.task.companies，项目状态固定为302、303、304、305、306、310，查询订单后与入参订单条件取交集；未配置有效分公司或交集为空时返回空页；支持排序与跟进人/大区筛选；支持按下次跟进时间区间（nextFollowUpTimeBegin/nextFollowUpTimeEnd，闭区间，取值来自跟进记录 follow_up_record 最新一条约跟进的 next_follow_up_time）筛选，未约下次跟进的任务不命中")
    ResultDTO<Page<FollowUpTaskDTO>> search(@RequestBody FollowUpTaskPageQueryParam param);

    @PostMapping(value = "api/construction/follow-up/task/order/search")
    @ApiOperation(value = "模糊搜索查项目订单 id 列表（页面模糊搜索配套，先查订单再查任务）", notes = "订单号/小区/业主/服务者等模糊搜索；分公司取服务端跟进公司配置（follow.up.task.companies），不接受入参指定；项目状态由服务端枚举固定，结果与跟单范围交集后截断 100")
    ResultDTO<List<String>> searchOrderIds(@RequestBody @Validated FollowUpOrderSearchParam param);

@PostMapping(value = "api/construction/follow-up/task/materials")
    @ApiOperation(value = "查询配置的跟单品类列表", notes = "查询 Apollo 跟单生成规则中配置的品类，名称匹配029履约类目")
    ResultDTO<List<FollowUpMaterialDTO>> queryMaterials();
    @PostMapping(value = "api/construction/follow-up/task/companies")
    @ApiOperation(value = "查询跟单可选公司", notes = "返回配置的公司名称和分公司编码 mdmCode")
    ResultDTO<List<FollowUpCompanyDTO>> queryCompanies();

    @PostMapping(value = "api/construction/follow-up/task/project-statuses")
    @ApiOperation(value = "查询跟单可选项目状态", notes = "与订单搜索使用相同的 StatusEnum 状态：302、303、304、305、306、310，按编码升序")
    ResultDTO<List<FollowUpProjectStatusDTO>> queryProjectStatuses();
