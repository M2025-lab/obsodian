CREATE TABLE roomie_msg_issue (
  id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '主键',
  involved_message_ids JSON COMMENT '该问题对应的消息id列表（JSON数组，元素含 msgKey/id/role：FIRST_ASK/FOLLOW_UP/REPLY）',
  group_channel_id VARCHAR(64) NOT NULL DEFAULT '' COMMENT '来源群channelId',
  group_name VARCHAR(128) NOT NULL DEFAULT '' COMMENT '来源群名快照',
  sender_id VARCHAR(64) NOT NULL DEFAULT '' COMMENT '提问人ID',
  sender_name VARCHAR(64) NOT NULL DEFAULT '' COMMENT '提问人名称',
  question_type VARCHAR(32) NOT NULL DEFAULT 'OTHER' COMMENT '问题类型：MATERIAL_PROGRESS进度确认/MATERIAL_RECTIFY主材问题整改/BIZ_VERIFY咨询核对/CLOUD_CANCEL云助理操作取消/OTHER',
  detail TEXT COMMENT 'AI整理的问题描述：须包含业主、项目标识、供应商、品类、任务类型、诉求与当前进展等关键信息',
  status VARCHAR(32) NOT NULL DEFAULT 'PENDING' COMMENT '解决状态：PENDING待解决/RESOLVED已解决',
  resolve_time DATETIME DEFAULT NULL COMMENT '解决时间（status=RESOLVED时）',
  gmt_create DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  gmt_modified DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
  PRIMARY KEY (id),
  UNIQUE KEY uk_message (message_id),
  KEY idx_msg_key (msg_key),
  KEY idx_group (group_channel_id),
  KEY idx_type (question_type),
  KEY idx_sender (sender_id)
) COMMENT='问题汇总表（测试版）：一行=一个问题循环，AI归类产物';
我觉得这些就行了，另外那个status用整数类型。
