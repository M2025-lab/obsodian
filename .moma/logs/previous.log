starlord中数据上线，CREATE TABLE task_worker_measure_record (
  id bigint NOT NULL AUTO_INCREMENT COMMENT '主键',
  task_dispatch_id bigint NOT NULL DEFAULT '0' COMMENT '主材任务id',
  task_dispatch_node_id bigint NOT NULL DEFAULT '0' COMMENT '节点任务id',
  qualified tinyint NOT NULL DEFAULT '0' COMMENT '是否可复尺：0-默认，1-可复尺，2-不可复尺',
  measure_data text COMMENT '测量数据JSON',
  images varchar(5000) NOT NULL DEFAULT '' COMMENT '图片地址',
  remark varchar(1000) NOT NULL DEFAULT '' COMMENT '备注',
  submit_time timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '工人提交（暂存）时间',
  executor_id varchar(32) NOT NULL DEFAULT '' COMMENT '执行人id',
  executor_name varchar(32) NOT NULL DEFAULT '' COMMENT '执行人姓名',
  create_time timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  update_time timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (id),
  UNIQUE KEY uk_task_dispatch_node_id (task_dispatch_node_id),
  KEY idx_task_id (task_dispatch_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='供应商复尺测量暂存表';
