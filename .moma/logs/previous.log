public List<MsgBlock> split(List<MsgAnalyzeMessageVO> flow) {
        List<MsgBlock> blocks = new ArrayList<>();
        if (flow == null || flow.isEmpty()) {
            return blocks;
        }
        MsgBlock current = null;
        Date lastHumanTime = null;
        for (MsgAnalyzeMessageVO msg : flow) {
            boolean human = MsgBlock.isHuman(msg);
            // 规则1：人消息且距上一条人消息超 GAP → 开新块
            if (human && (lastHumanTime == null
                    || msg.getMsgTime().getTime() - lastHumanTime.getTime() > gapMillis())) {
                current = new MsgBlock();
                current.setBlockStart(msg.getMsgTime());
                current.setMessages(new ArrayList<>());
                blocks.add(current);
            }
            // 规则2：机器人消息跟随归块——归入前一条人消息所在块；
            // 首条就是机器人消息（理论不该有，防御）自成一块
            if (current == null) {
                current = new MsgBlock();
                current.setBlockStart(msg.getMsgTime());
                current.setMessages(new ArrayList<>());
                blocks.add(current);
            }
            current.getMessages().add(msg);
            if (human) {
                lastHumanTime = msg.getMsgTime();
                current.setBlockEnd(msg.getMsgTime());
            }
        }
        return blocks;
    }讲一下这个逻辑。
